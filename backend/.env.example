# Solvix backend - Next.js (port 3001)
# Copy this file to .env.local and fill in your Supabase credentials.
# Never commit .env.local.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Allowed browser origins for CORS (comma separated). Defaults to the Vite dev
# server (http://localhost:5173) when unset.
# FRONTEND_ORIGIN=https://app.example.com

# Optional: largest invoice-level discount (percent) finance staff may apply
# without a manager. Defaults to 10.
# FINANCE_MAX_STAFF_DISCOUNT_PERCENT=10

# Razorpay (use rzp_test keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
