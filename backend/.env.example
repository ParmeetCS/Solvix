# Solvix Backend — Next.js (port 3001)
# Copy this file to .env.local and fill in your Supabase credentials.
# Never commit actual credentials.

# Supabase project (find these in Supabase project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: restrict CORS to the frontend origin in production
# FRONTEND_ORIGIN=http://localhost:5173
