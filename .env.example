# Frontend (Vite). Leave VITE_API_BASE_URL unset in development: requests go to
# /api/... and the Vite dev server proxies them to the backend on port 3001.
# Set it only when the backend is hosted on another origin, e.g.
# VITE_API_BASE_URL=https://api.example.com/api/v1
# (the backend must then list this site in FRONTEND_ORIGIN).
#
# VITE_API_BASE_URL=
